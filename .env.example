# ==========================================
# ShopAI - Environment Configuration Template
# Copy this file to .env or backend/.env and update values
# ==========================================

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shopai_db

# Application URLs & Ports
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Credentials (Required for Phase 5)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI API Key (Required for Phase 7 AI Support Agent)
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Credentials (Required for Phase 6 Test Checkout & Webhooks)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
